<!DOCTYPE html>
<html>
  <head>
    <title>SouverainIA - Infrastructure IA Souveraine</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body>
    <% if controller_name == 'home' && action_name == 'index' %>
      <%= render 'layouts/navbar' %>
      <%= yield %>
    <% else %>
      <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
          <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
            <span class="bg-gradient-primary p-2 rounded me-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
              <i class="fas fa-brain text-white"></i>
            </span>
            <span class="fw-bold">SouverainIA</span>
          <% end %>
          <div class="navbar-nav">
            <%= link_to 'Accueil', root_path, class: 'nav-link' %>
            <%= link_to 'Tableau de Bord', dashboard_index_path, class: 'nav-link' %>
            <%= link_to 'Modèles IA', ai_models_path, class: 'nav-link' %>
            <%= link_to 'Pipelines', pipelines_path, class: 'nav-link' %>
          </div>
          <div class="navbar-nav ms-auto">
            <span class="nav-link">Demo Mode</span>
          </div>
        </div>
      </nav>

      <div class="container mt-4">
        <%= yield %>
      </div>
    <% end %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof AOS !== 'undefined') {
          AOS.init({
            duration: 800,
            once: true,
            mirror: true
          });
        }
      });
    </script>
  </body>
</html>
