<div class="content-wrapper">
  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to 'Modèles IA', ai_models_path, class: 'text-decoration-none' %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= @ai_model.name %></li>
        </ol>
      </nav>
      <h1 class="display-6 fw-bold text-gradient mb-0"><%= @ai_model.name %></h1>
    </div>
    <div class="d-flex gap-2">
      <%= link_to edit_ai_model_path(@ai_model), class: 'btn-gradient' do %>
        <i class="fas fa-edit me-2"></i>Éditer
      <% end %>
      <div class="dropdown">
        <button class="btn btn-light" type="button" data-bs-toggle="dropdown">
          <i class="fas fa-ellipsis-v"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><a class="dropdown-item" href="#"><i class="fas fa-download me-2"></i>Exporter</a></li>
          <li><a class="dropdown-item" href="#"><i class="fas fa-copy me-2"></i>Dupliquer</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-trash me-2"></i>Supprimer</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="row g-4">
    <!-- Left Column -->
    <div class="col-lg-8">
      <!-- Model Overview Card -->
      <div class="modern-card mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Vue d'ensemble</h5>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-center mb-3">
                <div class="rounded p-2 me-3" style="background: rgba(102, 126, 234, 0.1)">
                  <i class="fas fa-brain text-primary"></i>
                </div>
                <div>
                  <h6 class="mb-1">Type de modèle</h6>
                  <p class="mb-0 text-muted">Transformers NLP</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center mb-3">
                <div class="rounded p-2 me-3" style="background: rgba(72, 187, 120, 0.1)">
                  <i class="fas fa-check-circle text-success"></i>
                </div>
                <div>
                  <h6 class="mb-1">Statut</h6>
                  <p class="mb-0">
                    <span class="badge badge-modern badge-success">
                      <i class="fas fa-circle me-1" style="font-size: 8px"></i>
                      <%= @ai_model.status %>
                    </span>
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <div class="rounded p-2 me-3" style="background: rgba(237, 137, 54, 0.1)">
                  <i class="fas fa-user text-warning"></i>
                </div>
                <div>
                  <h6 class="mb-1">Propriétaire</h6>
                  <p class="mb-0 text-muted"><%= @ai_model.user.email %></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <div class="rounded p-2 me-3" style="background: rgba(229, 62, 62, 0.1)">
                  <i class="fas fa-clock text-danger"></i>
                </div>
                <div>
                  <h6 class="mb-1">Dernière mise à jour</h6>
                  <p class="mb-0 text-muted"><%= @ai_model.updated_at.strftime("%d/%m/%Y %H:%M") %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Performance Metrics -->
      <div class="modern-card mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Métriques de Performance</h5>
          <canvas id="performanceChart" height="200"></canvas>
        </div>
      </div>

      <!-- Training Progress -->
      <div class="modern-card">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Progression de l'Entraînement</h5>
          <canvas id="trainingChart" height="200"></canvas>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-4">
      <!-- Model Info Card -->
      <div class="modern-card mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Informations</h5>
          <div class="mb-4">
            <h6 class="text-muted mb-2">Description</h6>
            <p class="mb-0"><%= @ai_model.description %></p>
          </div>
          <div>
            <h6 class="text-muted mb-3">Paramètres du modèle</h6>
            <div class="d-flex justify-content-between mb-2">
              <span>Taille du batch</span>
              <span class="fw-bold">32</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Epochs</span>
              <span class="fw-bold">100</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Learning rate</span>
              <span class="fw-bold">0.001</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Model Files -->
      <div class="modern-card">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-4">Fichiers du Modèle</h5>
          <% if @ai_model.model_files.attached? %>
            <div class="list-group list-group-flush">
              <% @ai_model.model_files.each do |file| %>
                <div class="list-group-item d-flex align-items-center border-0 px-0">
                  <div class="rounded p-2 me-3" style="background: rgba(102, 126, 234, 0.1)">
                    <i class="fas fa-file text-primary"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-0"><%= file.filename %></h6>
                    <small class="text-muted"><%= number_to_human_size(file.byte_size) %></small>
                  </div>
                  <%= link_to rails_blob_path(file), class: 'btn btn-light btn-sm rounded-circle', target: '_blank' do %>
                    <i class="fas fa-download"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">Aucun fichier attaché</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Performance Chart
  const performanceCtx = document.getElementById('performanceChart').getContext('2d');
  new Chart(performanceCtx, {
    type: 'line',
    data: {
      labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'],
      datasets: [{
        label: 'Précision',
        data: [85, 87, 89, 88, 92, 95],
        borderColor: '#667eea',
        tension: 0.4,
        fill: false
      }, {
        label: 'Rappel',
        data: [82, 85, 87, 89, 91, 93],
        borderColor: '#764ba2',
        tension: 0.4,
        fill: false
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          max: 100
        }
      }
    }
  });

  // Training Progress Chart
  const trainingCtx = document.getElementById('trainingChart').getContext('2d');
  new Chart(trainingCtx, {
    type: 'line',
    data: {
      labels: Array.from({length: 10}, (_, i) => `Epoch ${i + 1}`),
      datasets: [{
        label: 'Loss',
        data: [0.5, 0.45, 0.4, 0.35, 0.32, 0.3, 0.28, 0.26, 0.25, 0.24],
        borderColor: '#48bb78',
        backgroundColor: 'rgba(72, 187, 120, 0.1)',
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
});
</script>