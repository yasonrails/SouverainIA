            <i class="fas fa-play me-2"></i>
            Voir la Démo
          </a>
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-left">
        <div class="position-relative">
          <img src="https://placehold.co/600x400/1a237e/FFFFFF/png" alt="Interface SouverainIA" class="img-fluid rounded-4 shadow-lg">
          <div class="position-absolute bottom-0 end-0 bg-white p-4 rounded-4 shadow-lg" style="transform: translate(20%, 20%)">
            <div class="d-flex align-items-center gap-3">
              <div class="text-primary">
                <i class="fas fa-shield-alt fa-2x"></i>
              </div>
              <div>
