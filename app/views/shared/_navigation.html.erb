<nav class="nav-glass">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <!-- Logo -->
      <div class="d-flex align-items-center gap-3">
        <div class="nav-logo rounded-circle p-2" style="background: linear-gradient(135deg, var(--primary-500), var(--secondary-500));">
          <i class="fas fa-brain fa-lg text-white"></i>
        </div>
        <h1 class="h4 mb-0 fw-bold">SouverainIA</h1>
      </div>

      <!-- Navigation Links -->
      <div class="d-none d-lg-flex align-items-center gap-4">
        <%= link_to "Accueil", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
        <%= link_to "Dashboard", dashboard_index_path, class: "nav-link #{'active' if current_page?(dashboard_index_path)}" %>
        <%= link_to "Modèles", ai_models_path, class: "nav-link #{'active' if controller_name == 'ai_models'}" %>
        <%= link_to "Pipelines", pipelines_path, class: "nav-link #{'active' if controller_name == 'pipelines'}" %>
        
        <div class="nav-divider"></div>
        
        <div class="dropdown">
          <button class="btn btn-glass dropdown-toggle" data-bs-toggle="dropdown">
            <div class="d-flex align-items-center gap-2">
              <div class="avatar">
                <i class="fas fa-user"></i>
              </div>
              <span><%= current_user.email %></span>
            </div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#"><i class="fas fa-user-circle me-2"></i>Profile</a></li>
            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Paramètres</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                <i class="fas fa-sign-out-alt me-2"></i>Déconnexion
              <% end %>
            </li>
          </ul>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button class="btn btn-icon d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="offcanvas offcanvas-end" id="mobileMenu">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title">Menu</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div class="d-flex flex-column gap-3">
      <%= link_to root_path, class: "mobile-nav-link #{'active' if current_page?(root_path)}" do %>
        <i class="fas fa-home me-2"></i>Accueil
      <% end %>
      
      <%= link_to dashboard_index_path, class: "mobile-nav-link #{'active' if current_page?(dashboard_index_path)}" do %>
        <i class="fas fa-tachometer-alt me-2"></i>Dashboard
      <% end %>
      
      <%= link_to ai_models_path, class: "mobile-nav-link #{'active' if controller_name == 'ai_models'}" do %>
        <i class="fas fa-brain me-2"></i>Modèles
      <% end %>
      
      <%= link_to pipelines_path, class: "mobile-nav-link #{'active' if controller_name == 'pipelines'}" do %>
        <i class="fas fa-cogs me-2"></i>Pipelines
      <% end %>
      
      <hr>
      
      <%= link_to "#", class: "mobile-nav-link" do %>
        <i class="fas fa-user-circle me-2"></i>Profile
      <% end %>
      
      <%= link_to "#", class: "mobile-nav-link" do %>
        <i class="fas fa-cog me-2"></i>Paramètres
      <% end %>
      
      <%= link_to destroy_user_session_path, method: :delete, class: "mobile-nav-link text-danger" do %>
        <i class="fas fa-sign-out-alt me-2"></i>Déconnexion
      <% end %>
    </div>
  </div>
</div>

<style>
.nav-glass {
  padding: 1rem 0;
}

.nav-logo {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-link {
  color: var(--neutral-600);
  text-decoration: none;
  font-weight: 500;
  transition: var(--transition-normal);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-lg);
}

.nav-link:hover {
  color: var(--primary-600);
  background: var(--primary-50);
}

.nav-link.active {
  color: var(--primary-600);
  background: var(--primary-50);
}

.nav-divider {
  width: 1px;
  height: 24px;
  background: var(--neutral-200);
}

.btn-glass {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-lg);
}

.avatar {
  width: 32px;
  height: 32px;
  background: var(--primary-100);
  color: var(--primary-600);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-nav-link {
  color: var(--neutral-700);
  text-decoration: none;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-lg);
  transition: var(--transition-normal);
  font-weight: 500;
}

.mobile-nav-link:hover,
.mobile-nav-link.active {
  background: var(--primary-50);
  color: var(--primary-600);
}

.dropdown-menu {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--neutral-200);
  padding: 0.5rem;
}

.dropdown-item {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-md);
}

.dropdown-item:hover {
  background: var(--primary-50);
  color: var(--primary-600);
}
</style>